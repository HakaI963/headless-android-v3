<?xml version="1.0" encoding="utf-8"?>
<!-- App picker: search field on top, one dense list below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/TextAppearance.Droid.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_apps" />

        <ImageButton
            android:id="@+id/apps_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/action_close"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <EditText
        android:id="@+id/apps_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_field"
        android:hint="@string/action_apps"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:padding="12dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="15sp" />

    <ListView
        android:id="@+id/apps_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@drawable/bg_hairline"
        android:dividerHeight="1dp"
        android:paddingTop="8dp"
        android:scrollbarStyle="outsideOverlay" />

    <TextView
        android:id="@+id/apps_empty"
        style="@style/TextAppearance.Droid.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />
</LinearLayout>