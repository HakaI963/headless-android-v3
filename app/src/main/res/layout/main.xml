<?xml version="1.0" encoding="utf-8"?>
<!--
  The grid screen: quiet chrome at the top and bottom, the tiles in the middle.
  Nothing scrolls horizontally except the action bar, which only appears when a
  tile is selected.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/TextAppearance.Droid.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/TextAppearance.Droid.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grid_subtitle" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_columns"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/settings_columns"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_grid" />

        <ImageButton
            android:id="@+id/btn_apps"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/action_apps"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_plus" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/settings_title"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/hairline" />

    <!-- Status strip: two dots and the numbers an operator actually needs. -->
    <LinearLayout
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/status_shell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/dot_shell"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="@string/shell_title"
                android:src="@drawable/dot_idle" />

            <TextView
                android:id="@+id/text_shell"
                style="@style/TextAppearance.Droid.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/shell_title" />
        </LinearLayout>

        <View
            android:layout_width="@dimen/hairline"
            android:layout_height="12dp"
            android:layout_marginHorizontal="12dp"
            android:background="@color/hairline_strong" />

        <LinearLayout
            android:id="@+id/status_mcp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/dot_mcp"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="@string/mcp_title"
                android:src="@drawable/dot_idle" />

            <TextView
                android:id="@+id/text_mcp"
                style="@style/TextAppearance.Droid.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/mcp_title" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.bliss.headlessdroid.GridView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false" />

            <LinearLayout
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextAppearance.Droid.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:text="@string/grid_empty" />

                <LinearLayout
                    android:id="@+id/empty_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_accent"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="@string/action_add"
                        android:src="@drawable/ic_plus"
                        android:tint="@color/on_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="8dp"
                        android:paddingVertical="10dp"
                        android:paddingEnd="16dp"
                        android:text="@string/action_add"
                        android:textColor="@color/on_accent"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <!-- Action bar: only for the selected slot. -->
    <HorizontalScrollView
        android:id="@+id/actions_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </HorizontalScrollView>
</LinearLayout>