<?xml version="1.0" encoding="utf-8"?>
<!--
  The run screen. A real app shell: title, one session card, one section,
  the live displays, and a labelled control panel for the selected display.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_5"
        android:paddingTop="@dimen/space_5"
        android:paddingEnd="@dimen/space_5"
        android:paddingBottom="@dimen/space_4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/TextAppearance.Droid.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grid_title" />

            <TextView
                android:id="@+id/tagline"
                style="@style/TextAppearance.Droid.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/grid_tagline" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_columns"
            android:layout_width="@dimen/control_h"
            android:layout_height="@dimen/control_h"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/action_columns"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_grid" />

        <ImageButton
            android:id="@+id/btn_apps"
            android:layout_width="@dimen/control_h"
            android:layout_height="@dimen/control_h"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/bg_button_accent"
            android:contentDescription="@string/action_add"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_plus"
            android:tint="@color/on_accent" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="@dimen/control_h"
            android:layout_height="@dimen/control_h"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/settings_title"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- One session card: the two facts an operator needs before driving apps. -->
    <LinearLayout
        android:id="@+id/session"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_5"
        android:layout_marginEnd="@dimen/space_5"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <TextView
            style="@style/TextAppearance.Droid.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/session_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/status_shell"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/space_1">

                <ImageView
                    android:id="@+id/dot_shell"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/shell_title"
                    android:src="@drawable/dot_idle" />

                <TextView
                    android:id="@+id/text_shell"
                    style="@style/TextAppearance.Droid.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/shell_title" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/hairline"
                android:layout_height="24dp"
                android:layout_marginHorizontal="@dimen/space_3"
                android:background="@color/hairline" />

            <LinearLayout
                android:id="@+id/status_mcp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/space_1">

                <ImageView
                    android:id="@+id/dot_mcp"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/mcp_title"
                    android:src="@drawable/dot_idle" />

                <TextView
                    android:id="@+id/text_mcp"
                    style="@style/TextAppearance.Droid.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/mcp_title" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_5"
        android:layout_marginTop="@dimen/space_6"
        android:layout_marginEnd="@dimen/space_5"
        android:layout_marginBottom="@dimen/space_3"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.Droid.Section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/grid_section" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/TextAppearance.Droid.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grid_subtitle" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/space_5"
        android:paddingEnd="@dimen/space_5">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.bliss.headlessandroid.GridView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false" />

            <LinearLayout
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.bliss.headlessandroid.EmptyStateView
                    android:layout_width="200dp"
                    android:layout_height="140dp" />

                <TextView
                    style="@style/TextAppearance.Droid.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    android:text="@string/grid_empty_title" />

                <TextView
                    style="@style/TextAppearance.Droid.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/grid_empty_body" />

                <TextView
                    style="@style/TextAppearance.Droid.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/grid_empty_hint" />

                <TextView
                    android:id="@+id/empty_add"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/control_h"
                    android:layout_marginTop="@dimen/space_5"
                    android:background="@drawable/bg_button_accent"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_5"
                    android:paddingEnd="@dimen/space_5"
                    android:text="@string/action_add"
                    android:textColor="@color/on_accent"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <!-- Selected display controls. Labelled, in one aligned grid. -->
    <LinearLayout
        android:id="@+id/actions_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_5"
        android:layout_marginEnd="@dimen/space_5"
        android:layout_marginBottom="@dimen/space_4"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="@dimen/space_4"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/actions_title"
                style="@style/TextAppearance.Droid.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/grid_section" />

            <ImageButton
                android:id="@+id/actions_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_button"
                android:contentDescription="@string/action_close"
                android:padding="8dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:columnCount="4"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>
