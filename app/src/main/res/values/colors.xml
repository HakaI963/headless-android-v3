<?xml version="1.0" encoding="utf-8"?>
<!--
  Headless Droid color ramp: one tinted neutral ramp (graphite, slightly cool)
  plus exactly one accent (signal amber). Nothing in the chrome carries color;
  the color lives inside the tiles, where the real apps run.
-->
<resources>
    <!-- neutrals, dark ramp -->
    <color name="bg">#FF121417</color>
    <color name="surface">#FF191C1F</color>
    <color name="raised">#FF20242A</color>
    <color name="pressed">#FF262B31</color>
    <color name="hairline">#FF2A2F35</color>
    <color name="hairline_strong">#FF39404A</color>

    <!-- text roles -->
    <color name="text_primary">#FFE6E9EC</color>
    <color name="text_secondary">#FFA0A8B0</color>
    <color name="text_muted">#FF6B747C</color>

    <!-- the one accent -->
    <color name="accent">#FFE0A458</color>
    <color name="accent_dim">#FF8A6B34</color>
    <color name="on_accent">#FF1A1206</color>

    <!-- status colors, toned down to sit inside the ramp -->
    <color name="live">#FFE0A458</color>
    <color name="idle">#FF4E5761</color>
    <color name="stopped">#FF6B747C</color>
    <color name="danger">#FFC96A5E</color>
    <color name="good">#FF7BAF95</color>

    <!-- launcher plate -->
    <color name="launcher">#FF121417</color>
</resources>
